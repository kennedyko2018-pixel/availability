  <!-- ========================================================================
       LÓGICA DO APLICATIVO (JAVASCRIPT)
       ======================================================================== -->
  <script>
    (() => {
      // ======================================================================
      // 1. CONFIGURAÇÕES E CATÁLOGOS
      // ======================================================================
      const STORAGE_KEY = 'detran_xp_records_v1';
      const GOAL_KEY = 'detran_xp_daily_goal';
      const THEME_KEY = 'detran_xp_theme_v1';
      const SOUND_KEY = 'detran_xp_sound_v1';

      // Processos de Conferência (somam +1 na meta de conferidos + XP)
      const CONFERENCIA_TYPES = [
        {
          id: 'normal',
          name: 'Processo Normal',
          desc: 'Conferência padrão sem PJ ou procuração.',
          points: 1,
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.1" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><path d="M9 14l2 2 4-4"/></svg>`
        },
        {
          id: 'onepj',
          name: '1 Parte PJ ou Procuração',
          desc: 'Uma parte CNPJ ou procuração no processo.',
          points: 2,
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.1" viewBox="0 0 24 24"><path d="M3 21h18"/><path d="M5 21V7l8-4v18"/><path d="M19 21V11l-6-4"/><path d="M9 9h.01M9 13h.01M9 17h.01"/></svg>`
        },
        {
          id: 'twopj',
          name: '2 Partes PJ ou 2 Procurações',
          desc: 'Ambas as partes CNPJ ou duas procurações.',
          points: 3,
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.1" viewBox="0 0 24 24"><path d="M2 21h20"/><path d="M4 21V6l6-3v18"/><path d="M14 21V6l6-3v18"/><path d="M7 9h.01M7 13h.01M17 9h.01M17 13h.01"/></svg>`
        },
        {
          id: 'leilao',
          name: 'Leilão',
          desc: 'Conferência de veículo oriundo de leilão.',
          points: 4,
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.1" viewBox="0 0 24 24"><path d="M14.5 3.5l6 6-3 3-6-6 3-3z"/><path d="M11.5 6.5l-7 7a2.12 2.12 0 0 0 3 3l7-7"/><path d="M3 21h10"/></svg>`
        },
        {
          id: 'decisao',
          name: 'Inventário ou Judicial',
          desc: 'Transferência por inventário ou ordem judicial.',
          points: 5,
          icon: `<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.1" viewBox="0 0 24 24"><path d="M12 3v18"/><path d="M5 7h14"/><path d="M5 7l-2 7h4l-2-7z"/><path d="M19 7l-2 7h4l-2-7z"/><path d="M8 21h8"/></svg>`
        }
      ];

      // Serviços selecionáveis para Processo Digitado (Apenas XP)
      const DIGITADO_SERVICES = [
        { id: 'transferencia', label: 'Transferência', points: 1 },
        { id: 'alteracao', label: 'Alteração de dados', points: 1 },
        { id: 'primeiro_emplacamento', label: '1º Emplacamento', points: 1 },
        { id: 'segunda_via_crv', label: '2ª Via CRV', points: 2 },
        { id: 'baixa', label: 'Baixa', points: 2 }
      ];

      // ======================================================================
      // 2. ESTADO DA APLICAÇÃO
      // ======================================================================
      let records = loadRecords();
      let dailyGoal = loadGoal();
      let selectedServiceId = DIGITADO_SERVICES[0].id;
      let soundEnabled = loadPreference(SOUND_KEY, 'on') === 'on';
      let currentTheme = loadPreference(THEME_KEY, 'dark');
      let audioCtx = null;
      let toastTimer = null;
      let confettiAnimId = null;

      const $ = (id) => document.getElementById(id);

      // ======================================================================
      // 3. PERSISTÊNCIA SEGURA (LOCALSTORAGE)
      // ======================================================================
      function loadRecords() {
        try {
          const raw = localStorage.getItem(STORAGE_KEY);
          const parsed = raw ? JSON.parse(raw) : [];
          return Array.isArray(parsed) ? parsed : [];
        } catch (err) {
          console.error('Erro ao ler histórico:', err);
          return [];
        }
      }

      function saveRecords() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(records));
        } catch (err) {
          console.error('Erro ao salvar histórico:', err);
          showToast('Aviso: não foi possível salvar no navegador.');
        }
      }

      function loadGoal() {
        try {
          const raw = Number(localStorage.getItem(GOAL_KEY));
          return raw && raw >= 1 ? Math.floor(raw) : 30;
        } catch {
          return 30;
        }
      }

      function saveGoal(val) {
        dailyGoal = Math.max(1, Math.min(999, Math.floor(Number(val) || 30)));
        try {
          localStorage.setItem(GOAL_KEY, String(dailyGoal));
        } catch {
          // Ignora erro em modo privado
        }
      }

      function loadPreference(key, fallback) {
        try {
          return localStorage.getItem(key) || fallback;
        } catch {
          return fallback;
        }
      }

      function savePreference(key, value) {
        try {
          localStorage.setItem(key, value);
        } catch {
          // Ignora erro em modo privado
        }
      }

      // ======================================================================
      // 4. UTILITÁRIOS DE DATA E CLASSIFICAÇÃO
      // ======================================================================
      function getTodayKey() {
        const d = new Date();
        const yyyy = d.getFullYear();
        const mm = String(d.getMonth() + 1).padStart(2, '0');
        const dd = String(d.getDate()).padStart(2, '0');
        return `${yyyy}-${mm}-${dd}`;
      }

      function getCurrentMonthKey() {
        return getTodayKey().slice(0, 7);
      }

      function formatDateBR(dateKey) {
        const d = new Date(dateKey + 'T12:00:00');
        return d.toLocaleDateString('pt-BR', { day: '2-digit', month: '2-digit', year: 'numeric' });
      }

      function formatMonthName(monthKey) {
        const [y, m] = monthKey.split('-');
        const d = new Date(Number(y), Number(m) - 1, 1);
        return d.toLocaleDateString('pt-BR', { month: 'long', year: 'numeric' });
      }

      function isDigitado(r) {
        return r.type === 'digitado';
      }

      function isDevolvido(r) {
        return r.type === 'devolvido';
      }

      function isConferido(r) {
        return !isDigitado(r) && !isDevolvido(r);
      }

      function sumPoints(list) {
        return list.reduce((acc, item) => acc + (Number(item.points) || 0), 0);
      }

      function countConferidos(list) {
        return list.filter(isConferido).length;
      }

      function countDigitados(list) {
        return list.filter(isDigitado).length;
      }

      function countDevolvidos(list) {
        return list.filter(isDevolvido).length;
      }

      // ======================================================================
      // 5. EFEITOS SONOROS (WEB AUDIO API)
      // ======================================================================
      function playSound(mode = 'score') {
        if (!soundEnabled) return;
        try {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          if (!AudioContextClass) return;
          if (!audioCtx) audioCtx = new AudioContextClass();
          if (audioCtx.state === 'suspended') audioCtx.resume();

          const now = audioCtx.currentTime;

          if (mode === 'celebration') {
            // Fanfarra animada de meta batida
            const notes = [523.25, 659.25, 783.99, 1046.5, 783.99, 1046.5];
            const times = [0, 0.08, 0.16, 0.25, 0.36, 0.45];
            notes.forEach((freq, idx) => {
              const osc = audioCtx.createOscillator();
              const gain = audioCtx.createGain();
              osc.type = 'triangle';
              osc.frequency.setValueAtTime(freq, now + times[idx]);
              gain.gain.setValueAtTime(0.001, now + times[idx]);
              gain.gain.exponentialRampToValueAtTime(0.14, now + times[idx] + 0.02);
              gain.gain.exponentialRampToValueAtTime(0.001, now + times[idx] + 0.28);
              osc.connect(gain);
              gain.connect(audioCtx.destination);
              osc.start(now + times[idx]);
              osc.stop(now + times[idx] + 0.3);
            });
          } else if (mode === 'neutral') {
            // Toque neutro para processo devolvido
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(340, now);
            osc.frequency.exponentialRampToValueAtTime(260, now + 0.1);
            gain.gain.setValueAtTime(0.001, now);
            gain.gain.exponentialRampToValueAtTime(0.08, now + 0.015);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.12);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.13);
          } else {
            // Pop satisfatório de pontuação
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'sine';
            osc.frequency.setValueAtTime(580, now);
            osc.frequency.exponentialRampToValueAtTime(880, now + 0.09);
            gain.gain.setValueAtTime(0.001, now);
            gain.gain.exponentialRampToValueAtTime(0.12, now + 0.015);
            gain.gain.exponentialRampToValueAtTime(0.001, now + 0.14);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start(now);
            osc.stop(now + 0.15);
          }
        } catch {
          // Falha silenciosa caso áudio esteja bloqueado
        }
      }

      // ======================================================================
      // 6. CONFETES & MODAL "QUEM FEZ, FEZ!!!"
      // ======================================================================
      function launchConfetti() {
        const canvas = $('confettiCanvas');
        const ctx = canvas.getContext('2d');
        canvas.classList.remove('hidden');

        const resize = () => {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
        };
        resize();

        const colors = ['#FF6B00', '#FF9447', '#FFD166', '#FFFFFF', '#22C55E', '#38BDF8'];
        const particles = Array.from({ length: 140 }, () => ({
          x: canvas.width / 2 + (Math.random() - 0.5) * 160,
          y: canvas.height / 2 + (Math.random() - 0.5) * 80,
          vx: (Math.random() - 0.5) * 16,
          vy: (Math.random() - 0.85) * 18 - 4,
          size: Math.random() * 8 + 5,
          color: colors[Math.floor(Math.random() * colors.length)],
          rotation: Math.random() * 360,
          vRot: (Math.random() - 0.5) * 12,
          life: 1
        }));

        if (confettiAnimId) cancelAnimationFrame(confettiAnimId);

        const tick = () => {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          let alive = 0;

          particles.forEach((p) => {
            p.x += p.vx;
            p.y += p.vy;
            p.vy += 0.32; // gravidade
            p.vx *= 0.99;
            p.rotation += p.vRot;
            p.life -= 0.008;

            if (p.life > 0 && p.y < canvas.height + 40) {
              alive++;
              ctx.save();
              ctx.globalAlpha = Math.max(0, p.life);
              ctx.translate(p.x, p.y);
              ctx.rotate((p.rotation * Math.PI) / 180);
              ctx.fillStyle = p.color;
              ctx.fillRect(-p.size / 2, -p.size / 3, p.size, p.size * 0.6);
              ctx.restore();
            }
          });

          if (alive > 0) {
            confettiAnimId = requestAnimationFrame(tick);
          } else {
            ctx.clearRect(0, 0, canvas.width, canvas.height);
            canvas.classList.add('hidden');
          }
        };

        confettiAnimId = requestAnimationFrame(tick);
      }

      function showCelebrationModal() {
        $('celebrationSubtitle').textContent = `Você atingiu a meta de ${dailyGoal} processos conferidos hoje na Retaguarda! Mandou muito bem! 👏🎉`;
        const modal = $('celebrationModal');
        modal.classList.remove('hidden');
        modal.classList.add('flex');
        launchConfetti();
        playSound('celebration');
      }

      function hideCelebrationModal() {
        const modal = $('celebrationModal');
        modal.classList.add('hidden');
        modal.classList.remove('flex');
      }

      // ======================================================================
      // 7. FEEDBACK VISUAL (FLOAT XP, POP E TOAST)
      // ======================================================================
      function spawnFloatingBadge(text, subtext, buttonEl, isNeutral = false) {
        const rect = buttonEl.getBoundingClientRect();
        const el = document.createElement('div');
        el.className = 'floating-xp tabular';
        if (isNeutral) {
          el.style.color = 'var(--text-secondary)';
          el.style.textShadow = 'none';
        }
        el.innerHTML = subtext
          ? `<div>${text}</div><div style="font-size: 0.72rem; opacity: 0.92;">${subtext}</div>`
          : text;
        el.style.left = `${rect.left + rect.width / 2}px`;
        el.style.top = `${rect.top + 4}px`;
        document.body.appendChild(el);

        setTimeout(() => el.remove(), 880);
      }

      function triggerScorePop() {
        const scoreEl = $('todayScore');
        scoreEl.classList.remove('animate-pop');
        void scoreEl.offsetWidth;
        scoreEl.classList.add('animate-pop');
      }

      function showToast(message) {
        const toast = $('toast');
        $('toastMsg').textContent = message;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.classList.remove('show');
        }, 2600);
      }

      // ======================================================================
      // 8. TEMA (DARK / LIGHT) E SOM
      // ======================================================================
      function applyTheme(theme) {
        currentTheme = theme;
        document.documentElement.setAttribute('data-theme', theme);
        savePreference(THEME_KEY, theme);

        $('themeToggle').innerHTML = theme === 'dark'
          ? `<svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/></svg>`
          : `<svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>`;
      }

      function updateSoundButton() {
        $('soundToggle').innerHTML = soundEnabled
          ? `<svg class="w-5 h-5 text-brand" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><path d="M15.54 8.46a5 5 0 0 1 0 7.07"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/></svg>`
          : `<svg class="w-5 h-5" style="color: var(--text-muted);" fill="none" stroke="currentColor" stroke-width="2.2" viewBox="0 0 24 24"><polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"/><line x1="23" y1="9" x2="17" y2="15"/><line x1="17" y1="9" x2="23" y2="15"/></svg>`;
      }

      // ======================================================================
      // 9. AÇÕES PRINCIPAIS (CONFERIDO / DIGITADO / DEVOLVIDO / DESFAZER)
      // ======================================================================
      function addConferido(typeId, buttonEl) {
        const type = CONFERENCIA_TYPES.find((t) => t.id === typeId);
        if (!type) return;

        const todayKey = getTodayKey();
        const prevConferidos = countConferidos(records.filter((r) => r.date === todayKey));

        records.push({
          id: Date.now() + Math.random(),
          date: todayKey,
          type: type.id,
          name: type.name,
          other: false,
          points: type.points,
          time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
        });

        saveRecords();

        const newConferidos = prevConferidos + 1;
        const justHitGoal = prevConferidos < dailyGoal && newConferidos >= dailyGoal;

        spawnFloatingBadge(`+${type.points} XP`, '+1 conferido', buttonEl);
        triggerScorePop();

        if (justHitGoal) {
          showCelebrationModal();
        } else {
          playSound('score');
        }

        renderAll();
      }

      function addDigitado(isOtherState, buttonEl) {
        const service = DIGITADO_SERVICES.find((s) => s.id === selectedServiceId) || DIGITADO_SERVICES[0];
        const earnedPoints = service.points + (isOtherState ? 1 : 0);

        records.push({
          id: Date.now() + Math.random(),
          date: getTodayKey(),
          type: 'digitado',
          name: 'Processo Digitado',
          service: service.id,
          serviceLabel: service.label,
          other: isOtherState,
          points: earnedPoints,
          time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
        });

        saveRecords();
        spawnFloatingBadge(`+${earnedPoints} XP`, 'Só XP', buttonEl);
        triggerScorePop();
        playSound('score');
        renderAll();
      }

      function addDevolvido(buttonEl) {
        records.push({
          id: Date.now() + Math.random(),
          date: getTodayKey(),
          type: 'devolvido',
          name: 'Processo Devolvido',
          other: false,
          points: 0,
          time: new Date().toLocaleTimeString('pt-BR', { hour: '2-digit', minute: '2-digit' })
        });

        saveRecords();
        spawnFloatingBadge('Devolvido', '0 XP', buttonEl, true);
        playSound('neutral');
        renderAll();
      }

      function undoLastRecord() {
        if (!records.length) return;
        const removed = records.pop();
        saveRecords();
        renderAll();
        const ptsText = removed.points > 0 ? ` (-${removed.points} XP)` : '';
        showToast(`Desfeito: ${removed.name}${ptsText}`);
      }

      // ======================================================================
      // 10. RENDERIZAÇÃO DOS CARDS DE REGISTRO
      // ======================================================================
      function renderConferenciaCards() {
        const grid = $('conferenciaGrid');
        grid.innerHTML = CONFERENCIA_TYPES.map((t) => `
          <article class="kp-card kp-process-card p-4 sm:p-5 flex flex-col justify-between gap-4">
            <div>
              <div class="flex items-start justify-between gap-2">
                <div
                  class="w-10 h-10 rounded-xl flex items-center justify-center shrink-0"
                  style="background: var(--brand-soft); color: var(--brand);"
                >
                  ${t.icon}
                </div>
                <span
                  class="px-2.5 py-1 rounded-xl text-xs font-black tabular shrink-0"
                  style="background: var(--brand-soft); color: var(--brand);"
                >
                  ${t.points} XP
                </span>
              </div>

              <h3 class="text-sm sm:text-[15px] font-extrabold tracking-tight mt-3 leading-snug">
                ${t.name}
              </h3>
              <p class="text-[11px] sm:text-xs font-medium mt-1 leading-relaxed" style="color: var(--text-secondary);">
                ${t.desc}
              </p>
            </div>

            <button
              type="button"
              class="btn-primary w-full py-2.5 px-3 text-xs sm:text-sm font-black tabular flex items-center justify-center gap-1"
              data-conf-type="${t.id}"
            >
              <span>+${t.points} XP</span>
            </button>
          </article>
        `).join('');

        grid.querySelectorAll('button[data-conf-type]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            const target = e.currentTarget;
            addConferido(target.dataset.confType, target);
          });
        });
      }

      function renderDigitadoServices() {
        const container = $('digitadoServices');
        container.innerHTML = DIGITADO_SERVICES.map((s) => {
          const isActive = s.id === selectedServiceId;
          return `
            <button
              type="button"
              class="service-chip p-2.5 text-left flex flex-col justify-between gap-1 ${isActive ? 'active' : ''}"
              data-service-id="${s.id}"
            >
              <span class="text-[11px] sm:text-xs font-extrabold leading-tight">${s.label}</span>
              <span class="text-[10px] font-black tabular opacity-85">${s.points} XP</span>
            </button>
          `;
        }).join('');

        const activeService = DIGITADO_SERVICES.find((s) => s.id === selectedServiceId) || DIGITADO_SERVICES[0];
        $('btnDigitadoNormalPts').textContent = `+${activeService.points} XP`;
        $('btnDigitadoOutroPts').textContent = `+${activeService.points + 1} XP`;

        container.querySelectorAll('button[data-service-id]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            selectedServiceId = e.currentTarget.dataset.serviceId;
            renderDigitadoServices();
          });
        });
      }

      // ======================================================================
      // 11. RENDERIZAÇÃO GERAL (HERO, RANKING, RESUMO MENSAL E HISTÓRICO)
      // ======================================================================
      function renderAll() {
        const todayKey = getTodayKey();
        const currentMonthKey = getCurrentMonthKey();
        const selectedMonthKey = $('monthPicker').value || currentMonthKey;

        $('todayLabel').textContent = new Date().toLocaleDateString('pt-BR', {
          weekday: 'short',
          day: '2-digit',
          month: 'short',
          year: 'numeric'
        });

        const todayRows = records.filter((r) => r.date === todayKey);
        const todayXP = sumPoints(todayRows);
        const todayConf = countConferidos(todayRows);
        const todayDig = countDigitados(todayRows);
        const todayDev = countDevolvidos(todayRows);

        const currentMonthRows = records.filter((r) => r.date && r.date.startsWith(currentMonthKey));
        const currentMonthXP = sumPoints(currentMonthRows);

        // Atualiza Hero
        $('todayScore').textContent = todayXP;
        $('todayConferidos').textContent = todayConf;
        $('todayDigitados').textContent = todayDig;
        $('todayDevolvidos').textContent = todayDev;
        $('monthScore').textContent = currentMonthXP;
        $('currentMonthName').textContent = formatMonthName(currentMonthKey);

        // Atualiza Barra de Meta Diária de Conferidos
        const goalPct = Math.min(100, Math.round((todayConf / dailyGoal) * 100));
        const goalMet = todayConf >= dailyGoal;

        $('goalProgressText').textContent = `${todayConf} / ${dailyGoal} processos conferidos hoje`;
        $('goalBarFill').style.width = `${goalPct}%`;

        const heroCard = $('heroScoreCard');
        const badge = $('goalStatusBadge');
        if (goalMet) {
          heroCard.classList.add('goal-card-achieved');
          badge.textContent = 'Meta Batida! 🏆';
          badge.style.background = 'var(--brand-soft)';
          badge.style.color = 'var(--brand)';
          badge.style.borderColor = 'var(--brand-border)';
        } else {
          heroCard.classList.remove('goal-card-achieved');
          const faltam = dailyGoal - todayConf;
          badge.textContent = `Faltam ${faltam} para a meta`;
          badge.style.background = 'var(--bg-subcard)';
          badge.style.color = 'var(--text-secondary)';
          badge.style.borderColor = 'var(--border-subtle)';
        }

        renderDailyRanking(todayKey);
        renderMonthlySummary(selectedMonthKey);
        renderHistory();
      }

      function renderDailyRanking(todayKey) {
        const byDay = {};
        records.forEach((r) => {
          if (!r.date) return;
          if (!byDay[r.date]) {
            byDay[r.date] = { points: 0, conf: 0, dig: 0, dev: 0 };
          }
          byDay[r.date].points += Number(r.points) || 0;
          if (isConferido(r)) byDay[r.date].conf += 1;
          else if (isDigitado(r)) byDay[r.date].dig += 1;
          else if (isDevolvido(r)) byDay[r.date].dev += 1;
        });

        const ranking = Object.entries(byDay).sort(
          (a, b) => b[1].points - a[1].points || b[1].conf - a[1].conf || b[0].localeCompare(a[0])
        );

        $('totalDaysBadge').textContent = `${ranking.length} ${ranking.length === 1 ? 'dia' : 'dias'}`;

        if (!ranking.length) {
          $('dailyRanking').innerHTML = `
            <div class="kp-subcard p-6 text-center">
              <p class="text-sm font-bold">Nenhum dia registrado ainda</p>
              <p class="text-xs mt-1" style="color: var(--text-secondary);">
                Conferiu o primeiro processo na Retaguarda? Toque em um card acima para inaugurar o ranking!
              </p>
            </div>
          `;
          return;
        }

        const medals = ['🥇', '🥈', '🥉'];

        $('dailyRanking').innerHTML = `
          <div class="space-y-1.5">
            <div class="grid grid-cols-12 px-3 py-1.5 text-[10px] sm:text-[11px] font-extrabold uppercase tracking-wider" style="color: var(--text-muted);">
              <div class="col-span-5">Dia</div>
              <div class="col-span-2 text-center">Conf.</div>
              <div class="col-span-2 text-center">Dig.</div>
              <div class="col-span-1 text-center">Dev.</div>
              <div class="col-span-2 text-right">XP</div>
            </div>
            ${ranking.map(([date, stats], index) => {
              const isToday = date === todayKey;
              const hitGoal = stats.conf >= dailyGoal;
              const rankBadge = index < 3
                ? `<span class="text-base leading-none">${medals[index]}</span>`
                : `<span class="w-5 text-center text-xs font-extrabold tabular" style="color: var(--text-muted);">${index + 1}º</span>`;

              return `
                <div
                  class="grid grid-cols-12 items-center px-3 py-2.5 rounded-xl transition-colors ${isToday ? 'today-row' : ''}"
                  style="${isToday ? 'border: 1px solid var(--brand-border);' : 'background: var(--bg-subcard); border: 1px solid transparent;'}"
                >
                  <div class="col-span-5 flex items-center gap-1.5 min-w-0">
                    ${rankBadge}
                    <span class="text-xs sm:text-sm font-bold tabular truncate">${formatDateBR(date)}</span>
                    ${hitGoal ? '<span title="Meta diária batida">🏆</span>' : ''}
                    ${isToday ? '<span class="px-1.5 py-0.5 rounded-md text-[9px] font-black uppercase bg-brand text-white shrink-0">Hoje</span>' : ''}
                  </div>
                  <div class="col-span-2 text-center text-xs sm:text-sm font-extrabold tabular text-brand">
                    ${stats.conf}
                  </div>
                  <div class="col-span-2 text-center text-xs sm:text-sm font-bold tabular" style="color: var(--text-secondary);">
                    ${stats.dig}
                  </div>
                  <div class="col-span-1 text-center text-xs font-bold tabular" style="color: var(--text-muted);">
                    ${stats.dev}
                  </div>
                  <div class="col-span-2 text-right text-sm sm:text-base font-black tabular text-brand">
                    ${stats.points}
                  </div>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      function renderMonthlySummary(monthKey) {
        const monthRows = records.filter((r) => r.date && r.date.startsWith(monthKey));
        const totalXP = sumPoints(monthRows);
        const totalConf = countConferidos(monthRows);
        const totalDig = countDigitados(monthRows);
        const totalDev = countDevolvidos(monthRows);

        const daysMap = {};
        const confCounts = {};
        const serviceCounts = {};

        monthRows.forEach((r) => {
          if (!daysMap[r.date]) daysMap[r.date] = { points: 0, conf: 0, dig: 0, dev: 0 };
          daysMap[r.date].points += Number(r.points) || 0;

          if (isConferido(r)) {
            daysMap[r.date].conf += 1;
            const key = r.type || 'normal';
            confCounts[key] = (confCounts[key] || 0) + 1;
          } else if (isDigitado(r)) {
            daysMap[r.date].dig += 1;
            const sKey = r.serviceLabel || 'Não especificado';
            serviceCounts[sKey] = (serviceCounts[sKey] || 0) + 1;
          } else if (isDevolvido(r)) {
            daysMap[r.date].dev += 1;
          }
        });

        const daysWorked = Object.keys(daysMap).length;

        $('selectedMonthScore').textContent = totalXP;
        $('monthStatDays').textContent = daysWorked;
        $('monthStatConf').textContent = totalConf;
        $('monthStatDig').textContent = totalDig;
        $('monthStatDev').textContent = totalDev;

        if (!monthRows.length) {
          $('monthDetails').innerHTML = `
            <div class="kp-subcard p-5 text-center">
              <p class="text-xs sm:text-sm font-bold">Sem lançamentos neste mês</p>
              <p class="text-xs mt-1" style="color: var(--text-secondary);">
                Selecione outro mês ou comece a registrar processos hoje.
              </p>
            </div>
          `;
          return;
        }

        // Barras de Conferência por Tipo
        const confItems = CONFERENCIA_TYPES
          .map((t) => ({ name: t.name, count: confCounts[t.id] || 0 }))
          .filter((item) => item.count > 0)
          .sort((a, b) => b.count - a.count);

        const maxConf = Math.max(...confItems.map((i) => i.count), 1);
        const confBarsHTML = confItems.length
          ? `
            <div>
              <h3 class="text-[11px] font-extrabold uppercase tracking-wider mb-2.5" style="color: var(--text-muted);">
                Conferidos por Tipo
              </h3>
              <div class="space-y-2">
                ${confItems.map((item) => {
                  const pct = Math.max(6, Math.round((item.count / maxConf) * 100));
                  return `
                    <div>
                      <div class="flex items-center justify-between text-xs font-bold mb-1">
                        <span class="truncate pr-2">${item.name}</span>
                        <span class="tabular text-brand font-extrabold shrink-0">${item.count}</span>
                      </div>
                      <div class="w-full h-2 rounded-full overflow-hidden" style="background: var(--bg-subcard);">
                        <div class="h-full rounded-full bg-brand" style="width: ${pct}%;"></div>
                      </div>
                    </div>
                  `;
                }).join('')}
              </div>
            </div>
          `
          : '';

        // Detalhamento de Serviços Digitados
        const serviceEntries = Object.entries(serviceCounts).sort((a, b) => b[1] - a[1]);
        const digServicesHTML = serviceEntries.length
          ? `
            <div class="pt-1">
              <h3 class="text-[11px] font-extrabold uppercase tracking-wider mb-2" style="color: var(--text-muted);">
                Digitados por Serviço
              </h3>
              <div class="flex flex-wrap gap-1.5">
                ${serviceEntries.map(([label, count]) => `
                  <span class="px-2.5 py-1 rounded-xl text-xs font-bold tabular" style="background: var(--bg-subcard); border: 1px solid var(--border-subtle);">
                    ${label}: <strong class="text-brand font-black">${count}</strong>
                  </span>
                `).join('')}
              </div>
            </div>
          `
          : '';

        // Lista de dias do mês
        const daysListHTML = Object.entries(daysMap)
          .sort((a, b) => b[0].localeCompare(a[0]))
          .map(([date, stats]) => `
            <div class="flex items-center justify-between py-2 px-3 rounded-xl text-xs gap-2" style="background: var(--bg-subcard);">
              <span class="font-bold tabular shrink-0">
                ${formatDateBR(date)} ${stats.conf >= dailyGoal ? '🏆' : ''}
              </span>
              <span class="font-semibold tabular text-right" style="color: var(--text-secondary);">
                ${stats.conf} conf. &bull; ${stats.dig} dig. &bull; ${stats.dev} dev. &bull; <strong class="text-brand font-black">${stats.points} XP</strong>
              </span>
            </div>
          `)
          .join('');

        $('monthDetails').innerHTML = `
          ${confBarsHTML}
          ${digServicesHTML}
          <div class="pt-1">
            <h3 class="text-[11px] font-extrabold uppercase tracking-wider mb-2" style="color: var(--text-muted);">
              Dias no Mês
            </h3>
            <div class="space-y-1.5">${daysListHTML}</div>
          </div>
        `;
      }

      function renderHistory() {
        const undoBtn = $('undoBtn');
        undoBtn.disabled = !records.length;
        undoBtn.style.opacity = records.length ? '1' : '0.45';
        undoBtn.style.pointerEvents = records.length ? 'auto' : 'none';

        if (!records.length) {
          $('historyList').innerHTML = `
            <div class="kp-subcard p-5 text-center">
              <p class="text-xs sm:text-sm font-bold" style="color: var(--text-secondary);">
                Nenhum lançamento registrado ainda.
              </p>
            </div>
          `;
          return;
        }

        const latest = records.slice(-15).reverse();

        $('historyList').innerHTML = `
          <div class="space-y-2">
            ${latest.map((r) => {
              let categoryBadge = '';
              if (isDevolvido(r)) {
                categoryBadge = `<span class="px-2 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wide" style="background: var(--bg-card); color: var(--text-muted); border: 1px solid var(--border-subtle);">Devolvido</span>`;
              } else if (isDigitado(r)) {
                categoryBadge = `<span class="px-2 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wide" style="background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border-subtle);">Só XP</span>`;
              } else {
                categoryBadge = `<span class="px-2 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wide" style="background: var(--brand-soft); color: var(--brand); border: 1px solid var(--brand-border);">+1 conf.</span>`;
              }

              const serviceBadge = r.serviceLabel
                ? `<span class="px-2 py-0.5 rounded-lg text-[10px] font-bold" style="background: var(--bg-card); color: var(--text-primary); border: 1px solid var(--border-subtle);">${r.serviceLabel}</span>`
                : '';

              const otherBadge = r.other
                ? `<span class="px-2 py-0.5 rounded-lg text-[10px] font-black uppercase tracking-wide" style="background: var(--brand-soft); color: var(--brand); border: 1px solid var(--brand-border);">Outro Estado</span>`
                : '';

              return `
                <div class="kp-subcard px-3.5 py-3 flex items-center justify-between gap-3">
                  <div class="min-w-0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                      <span class="text-xs sm:text-sm font-extrabold truncate">${r.name}</span>
                      ${categoryBadge}
                      ${serviceBadge}
                      ${otherBadge}
                    </div>
                    <div class="text-[11px] font-semibold mt-0.5 tabular" style="color: var(--text-muted);">
                      ${formatDateBR(r.date)} &bull; ${r.time || '--:--'}
                    </div>
                  </div>
                  <span class="text-sm sm:text-base font-black tabular whitespace-nowrap shrink-0 ${r.points > 0 ? 'text-brand' : ''}" style="${r.points === 0 ? 'color: var(--text-muted);' : ''}">
                    ${r.points > 0 ? `+${r.points} XP` : '0 XP'}
                  </span>
                </div>
              `;
            }).join('')}
          </div>
        `;
      }

      // ======================================================================
      // 12. INICIALIZAÇÃO E EVENTOS
      // ======================================================================
      function init() {
        applyTheme(currentTheme);
        updateSoundButton();

        $('monthPicker').value = getCurrentMonthKey();

        // Alternância de tema e som
        $('themeToggle').addEventListener('click', () => {
          applyTheme(currentTheme === 'dark' ? 'light' : 'dark');
        });

        $('soundToggle').addEventListener('click', () => {
          soundEnabled = !soundEnabled;
          savePreference(SOUND_KEY, soundEnabled ? 'on' : 'off');
          updateSoundButton();
          if (soundEnabled) playSound('score');
          showToast(soundEnabled ? 'Efeitos sonoros ativados' : 'Efeitos sonoros silenciados');
        });

        // Edição inline da Meta Diária
        $('editGoalBtn').addEventListener('click', () => {
          $('goalInput').value = dailyGoal;
          $('editGoalBtn').classList.add('hidden');
          $('goalEditBox').classList.remove('hidden');
          $('goalEditBox').classList.add('flex');
          $('goalInput').focus();
          $('goalInput').select();
        });

        const closeGoalEdit = () => {
          $('goalEditBox').classList.add('hidden');
          $('goalEditBox').classList.remove('flex');
          $('editGoalBtn').classList.remove('hidden');
        };

        $('saveGoalBtn').addEventListener('click', () => {
          saveGoal($('goalInput').value);
          closeGoalEdit();
          renderAll();
          showToast(`Meta diária atualizada para ${dailyGoal} processos conferidos.`);
        });

        $('cancelGoalBtn').addEventListener('click', closeGoalEdit);
        $('goalInput').addEventListener('keydown', (e) => {
          if (e.key === 'Enter') $('saveGoalBtn').click();
          if (e.key === 'Escape') closeGoalEdit();
        });

        // Botões de Processo Digitado e Devolvido
        $('btnDigitadoNormal').addEventListener('click', (e) => addDigitado(false, e.currentTarget));
        $('btnDigitadoOutro').addEventListener('click', (e) => addDigitado(true, e.currentTarget));
        $('btnDevolvido').addEventListener('click', (e) => addDevolvido(e.currentTarget));

        // Modal Comemorativo
        $('closeCelebrationBtn').addEventListener('click', hideCelebrationModal);
        $('celebrationModal').addEventListener('click', (e) => {
          if (e.target === $('celebrationModal')) hideCelebrationModal();
        });

        // Mês e Desfazer
        $('monthPicker').addEventListener('change', renderAll);
        $('undoBtn').addEventListener('click', undoLastRecord);

        renderConferenciaCards();
        renderDigitadoServices();
        renderAll();
      }

      init();
    })();
  </script>
</body>
</html>
